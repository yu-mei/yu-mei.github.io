{% assign project_link = project.url | relative_url %}
{% if project.redirect %}
  {% assign project_link = project.redirect %}
{% endif %}
<div class="project-item row">
  {% if project.img %}
    <div class="col col-sm-3 project-thumb">
      <a href="{{ project_link }}">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="250px"
          alt=project.title
          class="img-fluid rounded z-depth-1"
          avoid_scaling=true
        %}
      </a>
    </div>
  {% endif %}
  <div class="{% if project.img %}col-sm-9{% else %}col-sm-12{% endif %} project-info">
    <a class="project-title" href="{{ project_link }}">{{ project.title }}</a>
    {% if project.meta or project.year %}
      <div class="project-meta">{{ project.meta }}{% if project.meta and project.year %}, {% endif %}{{ project.year }}</div>
    {% endif %}
    {% if project.meta2 %}<div class="project-meta">{{ project.meta2 }}</div>{% endif %}
    <p class="project-desc">{{ project.description }}</p>
    {% if project.pdf or project.code or project.video or project.website %}
      <div class="links">
        {% if project.pdf %}<a href="{{ project.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>{% endif %}
        {% if project.code %}<a href="{{ project.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>{% endif %}
        {% if project.video %}<a href="{{ project.video }}" class="btn btn-sm z-depth-0" role="button">Video</a>{% endif %}
        {% if project.website %}<a href="{{ project.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>{% endif %}
      </div>
    {% endif %}
  </div>
</div>
