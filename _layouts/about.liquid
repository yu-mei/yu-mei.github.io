---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">
      {{ content }}

    <!-- Research interests (kept INSIDE .clearfix so it sits right under the text, not below the photo) -->
    {% if page.research_tags and page.research_tags.size > 0 %}
      <style>
        .research-interests {
          clear: none; /* sit right under the text; set to `both` to drop below the photo */
          margin: 12px 0 8px;
        }
        .research-interests-title {
          text-transform: uppercase;
          letter-spacing: 0.06em;
          font-weight: 600;
          font-size: 0.78rem;
          color: var(--global-text-color-light);
          margin-bottom: 6px;
        }
        .research-tags {
          display: flex;
          flex-wrap: wrap;
          gap: 7px;
          max-width: 620px; /* keep pills under the text column; wraps onto ~two lines */
        }
        .research-tag {
          display: inline-block;
          padding: 3px 11px;
          border-radius: 999px;
          font-size: 0.78rem;
          font-weight: 400; /* pill text weight */
          line-height: 1.4;
          color: var(--global-theme-color);
          border: 1px solid var(--global-divider-color);
          background-color: rgba(0, 0, 0, 0.03); /* fallback for older browsers */
          background-color: color-mix(in srgb, var(--global-theme-color) 9%, transparent);
          transition: background-color 0.2s ease;
        }
        .research-tag:hover {
          background-color: color-mix(in srgb, var(--global-theme-color) 16%, transparent);
        }
      </style>

      <div class="research-interests">
        <div class="research-interests-title">Research Interests</div>
        <div class="research-tags">
          {% for tag in page.research_tags %}
            <span class="research-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    </div>
    <!-- end .clearfix -->

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <style>
        .news-link {
          text-decoration: none;
          color: inherit;
          font-size: 2.0em;
          margin-right: 10px;
        }
        .news-link:hover {
          text-decoration: underline;
        }
        .news-divider {
          flex-grow: 1;
          height: 1px;
          background-color: #ccc;
        }

        .news table.table td,
        .news table.table th {
          padding-top: 0.5rem;
          padding-bottom: 0.5rem;
          line-height: 1.2;
        }
        .news td p { margin: 0; }
      </style>

      <!-- Fancy Divider with Clickable News -->
      <div style="display: flex; align-items: center; margin: 20px 0 10px;">
        <a href="{{ '/news/' | relative_url }}" class="news-link">News</a>
        <div class="news-divider"></div>
      </div>

      {% include news.liquid limit=true %}
    {% endif %}


    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <style>
        .selected-link {
          text-decoration: none;
          color: inherit;
          font-size: 2.0em;
          font-weight: 400; /* match News/Publications link weight (base body weight is 300) */
          margin-right: 10px;
        }
        .selected-link:hover {
          text-decoration: underline;
        }
        .selected-divider {
          flex-grow: 1;
          height: 1px;
          background-color: #ccc; /* or var(--global-divider-color) */
        }
      </style>

      <!-- Fancy Divider with Clickable Selected Publications -->
      <div style="display: flex; align-items: center; margin: 30px 0 10px;">
        <a href="{{ '/publications/' | relative_url }}" class="selected-link">Selected Publications</a>
        <div class="selected-divider"></div>
      </div>

      <div class="home-highlights">
        {% include selected_papers.liquid %}
      </div>
    {% endif %}

    <!-- Selected projects -->
    {% if page.selected_projects %}
      <style>
        .selected-link {
          text-decoration: none;
          color: inherit;
          font-size: 2.0em;
          font-weight: 400; /* match News/Publications link weight (base body weight is 300) */
          margin-right: 10px;
        }
        .selected-link:hover {
          text-decoration: underline;
        }
        .selected-divider {
          flex-grow: 1;
          height: 1px;
          background-color: #ccc; /* or var(--global-divider-color) */
        }
      </style>

      <!-- Fancy Divider with Clickable Selected Projects -->
      <div style="display: flex; align-items: center; margin: 30px 0 10px;">
        <a href="{{ '/projects/' | relative_url }}" class="selected-link">Selected Technical Projects</a>
        <div class="selected-divider"></div>
      </div>

      <div class="home-highlights">
        {% include selected_projects.liquid %}
      </div>
    {% endif %}

    <!-- Sponsors -->
    {% if page.sponsors and page.sponsors.size > 0 %}
      <style>
        /* same heading look as the other sections (redefined here so the block is self-contained) */
        .selected-link { text-decoration: none; color: inherit; font-size: 2.0em; font-weight: 400; margin-right: 10px; }
        .selected-link:hover { text-decoration: underline; }
        .selected-divider { flex-grow: 1; height: 1px; background-color: #ccc; }

        .sponsors-row {
          display: flex;
          align-items: center;
          justify-content: center; /* group logos toward the center */
          flex-wrap: wrap;
          gap: 48px; /* spacing between logos */
          margin: 18px 0 8px;
        }
        .sponsors-row a { display: inline-flex; align-items: center; }
        .sponsors-row img {
          /* base max size is set inline per logo (see sponsor_base_h/w below) so each
             sponsor can be scaled individually via its `size` (percent) front-matter field */
          width: auto;
          height: auto;
          object-fit: contain;
        }
      </style>

      <!-- Fancy Divider (non-clickable title, matches Selected Projects) -->
      <div style="display: flex; align-items: center; margin: 30px 0 10px;">
        <span class="selected-link">Sponsors</span>
        <div class="selected-divider"></div>
      </div>

      {% comment %} Base logo size (px). Each sponsor's optional `size` (percent, default 100) scales it. {% endcomment %}
      {% assign sponsor_base_h = 130 %}
      {% assign sponsor_base_w = 250 %}

      <div class="sponsors-row">
        {% for s in page.sponsors %}
          {% assign sponsor_img = s.image | prepend: 'assets/img/' | relative_url %}
          {% assign size_pct = s.size | default: 100 %}
          {% assign max_h = sponsor_base_h | times: size_pct | divided_by: 100 %}
          {% assign max_w = sponsor_base_w | times: size_pct | divided_by: 100 %}
          {% capture sponsor_style %}max-height: {{ max_h }}px; max-width: {{ max_w }}px;{% endcapture %}
          {% if s.url %}
            <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" title="{{ s.name }}">
              <img src="{{ sponsor_img }}" alt="{{ s.name }}" style="{{ sponsor_style }}" loading="lazy" />
            </a>
          {% else %}
            <img src="{{ sponsor_img }}" alt="{{ s.name }}" style="{{ sponsor_style }}" loading="lazy" />
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}


    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    <!-- ClustrMaps Widget -->
    <div class="clustrmaps-widget" style="margin-top: 16px; text-align: center;">
      <script
        type="text/javascript"
        id="clustrmaps"
        src="//cdn.clustrmaps.com/map_v2.js?cl=ffffff&w=a&t=tt&d=HFUgaEXYKozR95L_iXzdtfwp1v7KSDxDzP2xl1FWJdw&w=240"
      ></script>
    </div>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

  </article>
</div>