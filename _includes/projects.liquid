{% assign project_link = project.url | relative_url %}
{% if project.redirect %}
  {% assign project_link = project.redirect %}
{% endif %}
<div class="project-item row">
  {% if project.img %}
    <div class="col-sm-3 project-thumb">
      <a href="{{ project_link }}">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes="250px"
          alt=project.title
          class="img-fluid rounded z-depth-1"
          avoid_scaling=true
        %}
      </a>
    </div>
  {% endif %}
  <div class="{% if project.img %}col-sm-9{% else %}col-sm-12{% endif %} project-info">
    <a class="project-title" href="{{ project_link }}">{{ project.title }}</a>
    {% if project.meta %}<div class="project-meta">{{ project.meta }}</div>{% endif %}
    <p class="project-desc">{{ project.description }}</p>
  </div>
</div>
