---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style type="text/css">
  .gallery-page .post-header {
    margin-bottom: 2rem;
  }

  .gallery-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--global-theme-color);
  }

  .gallery-page .post-title {
    font-weight: 700;
    line-height: 1.15;
  }

  .gallery-page .post-description {
    margin-top: 0.6rem;
    color: var(--global-text-color-light);
  }

  /* Card grid — 3 columns on desktop, 2 on tablet, 1 on phone */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.2rem 1.8rem;
  }

  .gallery-card {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* Fixed aspect ratio keeps every photo aligned, no matter its size */
  .gallery-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--global-card-bg-color);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .gallery-slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .gallery-slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
  }

  .gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .gallery-thumb:hover .gallery-slide.is-active img {
    transform: scale(1.04);
  }

  .gallery-carousel-control {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    background: rgba(20, 24, 28, 0.58);
    color: #fff;
    cursor: pointer;
    opacity: 0.78;
    transform: translateY(-50%);
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .gallery-carousel-control:hover,
  .gallery-carousel-control:focus-visible {
    background: rgba(20, 24, 28, 0.82);
    color: #fff;
    opacity: 1;
  }

  .gallery-carousel-control:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .gallery-carousel-control.previous {
    left: 0.55rem;
  }

  .gallery-carousel-control.next {
    right: 0.55rem;
  }

  .gallery-carousel-control i {
    font-size: 0.8rem;
    pointer-events: none;
  }

  .gallery-card-body {
    padding-top: 0.95rem;
  }

  .gallery-card-eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--global-theme-color);
  }

  .gallery-card-title {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--global-text-color);
  }

  .gallery-card-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 576px) {
    .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-slide,
    .gallery-slide img,
    .gallery-carousel-control {
      transition: none;
    }

    .gallery-thumb:hover .gallery-slide.is-active img {
      transform: none;
    }
  }
</style>

<div class="post gallery-page">
  <header class="post-header">
    {% if page.eyebrow != blank %}
      <p class="gallery-eyebrow">{{ page.eyebrow }}</p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% assign gallery_body = content | strip %}
    {% if gallery_body != '' %}
      {{ content }}
    {% endif %}

    <div class="gallery-grid">
      {% for item in page.gallery_items %}
        {% if item.images and item.images.size > 0 %}
          {% assign image_count = item.images.size %}
        {% elsif item.image %}
          {% assign image_count = 1 %}
        {% else %}
          {% assign image_count = 0 %}
        {% endif %}

        <figure class="gallery-card">
          {% if image_count > 0 %}
            <div
              class="gallery-thumb{% if image_count > 1 %} gallery-carousel{% endif %}"
              {% if image_count > 1 %}
                data-gallery-carousel
                role="group"
                aria-roledescription="carousel"
                aria-label="{{ item.label | default: item.caption | strip_html }} photos"
              {% endif %}
            >
              {% if item.images and item.images.size > 0 %}
                {% for image in item.images %}
                  {% capture image_alt %}Photo {{ forloop.index }} of {{ forloop.length }}: {{ item.caption | default: item.label | strip_html }}{% endcapture %}
                  {% if item.link %}
                    <a
                      class="gallery-slide{% if forloop.first %} is-active{% endif %}"
                      href="{{ item.link }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      data-gallery-slide
                      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                    >
                  {% else %}
                    <div
                      class="gallery-slide{% if forloop.first %} is-active{% endif %}"
                      data-gallery-slide
                      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                    >
                  {% endif %}
                    <img src="{{ image | relative_url }}" alt="{{ image_alt | strip }}" loading="lazy">
                  {% if item.link %}</a>{% else %}</div>{% endif %}
                {% endfor %}
              {% else %}
                {% if item.link %}
                  <a class="gallery-slide is-active" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">
                {% else %}
                  <div class="gallery-slide is-active">
                {% endif %}
                  <img
                    src="{{ item.image | relative_url }}"
                    alt="{{ item.caption | default: item.label | strip_html }}"
                    loading="lazy"
                    {% unless item.link %}data-zoomable{% endunless %}
                  >
                {% if item.link %}</a>{% else %}</div>{% endif %}
              {% endif %}

              {% if image_count > 1 %}
                <button class="gallery-carousel-control previous" type="button" data-gallery-previous aria-label="Previous photo">
                  <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>
                <button class="gallery-carousel-control next" type="button" data-gallery-next aria-label="Next photo">
                  <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
                <span class="sr-only" aria-live="polite" data-gallery-status>Photo 1 of {{ image_count }}</span>
              {% endif %}
            </div>
          {% endif %}

          <figcaption class="gallery-card-body">
            {% if item.label %}
              <p class="gallery-card-eyebrow">{{ item.label }}</p>
            {% endif %}
            {% if item.caption %}
              <p class="gallery-card-title">{{ item.caption }}</p>
            {% endif %}
            {% if item.date %}
              <p class="gallery-card-meta">{{ item.date }}</p>
            {% endif %}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </article>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-gallery-carousel]').forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll('[data-gallery-slide]'));
      const previous = carousel.querySelector('[data-gallery-previous]');
      const next = carousel.querySelector('[data-gallery-next]');
      const status = carousel.querySelector('[data-gallery-status]');
      let currentIndex = 0;
      let autoplayTimer;

      const showSlide = (newIndex) => {
        currentIndex = (newIndex + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          const isActive = index === currentIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', String(!isActive));
          if (slide.matches('a')) slide.tabIndex = isActive ? 0 : -1;
        });
        status.textContent = `Photo ${currentIndex + 1} of ${slides.length}`;
      };

      const stopAutoplay = () => {
        window.clearInterval(autoplayTimer);
        autoplayTimer = undefined;
      };

      const startAutoplay = () => {
        if (reduceMotion || autoplayTimer) return;
        autoplayTimer = window.setInterval(() => showSlide(currentIndex + 1), 1800);
      };

      const changeSlide = (step) => {
        showSlide(currentIndex + step);
        if (autoplayTimer) {
          stopAutoplay();
          startAutoplay();
        }
      };

      previous.addEventListener('click', () => changeSlide(-1));
      next.addEventListener('click', () => changeSlide(1));
      carousel.addEventListener('mouseenter', startAutoplay);
      carousel.addEventListener('mouseleave', stopAutoplay);
      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          changeSlide(-1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          changeSlide(1);
        }
      });

      showSlide(0);
    });
  });
</script>
